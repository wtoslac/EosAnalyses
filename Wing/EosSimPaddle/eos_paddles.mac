/glg4debug/glg4param omit_muon_processes  0.0
/glg4debug/glg4param omit_hadronic_processes  0.0
#set the detector parameters
/rat/db/set DETECTOR experiment "Eos"
/rat/db/set DETECTOR geo_file "Eos/Eos.geo"
/rat/db/set GEO[eos_inner] material "water"
/rat/db/load Eos/muonBottom.geo
#/rat/db/load Eos/muonTop.geo
#/rat/db/load Eos/muonBrl.geo

/rat/db/set SEEDNDESTROY pdf_type 1 #can select single PDF or per pmt PDFs (0 is per pmt, 1 is single)
#Use lognormal timing in the reconstruction
/rat/db/set FIT_COMMON mode 2
/rat/db/set FIT_COMMON waveform_analyzer "Lognormal"
# Set digitizer window length
/rat/db/set DIGITIZER[V1730] nsamples 110.0
/rat/db/set IO[NtupleProc] include_untriggered_events false
#/rat/db/set IO[NtupleProc] include_tracking true
#/rat/db/set IO[NtupleProc] include_mcparticles true
/rat/db/set NOISEPROC noise_flag 2
/rat/db/set PMTINFO_hqe_top noise_rate [42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000]
/rat/db/set PMTINFO_sides noise_rate [30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000,30000]
/rat/db/set PMTINFO_bottom noise_rate [42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000,42000]
/rat/db/set PMTINFO_bottom_back noise_rate [14000,14000,14000,14000,14000,14000,14000,14000,14000,14000,14000,14000,14000]

# Set cry variables for eos
/rat/db/set CRY latitude 37.8715
/rat/db/set CRY subboxLength 4
#/rat/db/set VertexGen EMaximum 1000
/rat/physics/setCerenkovMaxNumPhotonsPerStep 500
/rat/physics/enableCerenkov 1
/run/initialize
/rat/proc noise
#///rat/proc forcedtrigger
/rat/physics/scintillation/off
/tracking/storeTrajectory 1
 
# BEGIN EVENT LOOP
#/rat/proc forcedtrigger
/rat/proc splitevdaq
/rat/procset trigger_threshold 1.0
/control/getEnv EOSDATA
/control/execute {EOSDATA}/macros/snippets/waveformAnalysis.snippet
/rat/proc count
/rat/procset update 100
#/rat/proc/hitcleaning
/rat/proc quadfitter #QuadFitter needs to be first as it is a seed for SeedNDestroy
/rat/proc seedndestroy #choosing to do SeedNDestroy reconstruction during simulation
/rat/procset pdf_name "/seedndestroy/older/082025_ES2.0.0/pb_408nm_100ph_water_zscan_ES2.0.0_PDF_lognormal.root"
/rat/procset fitter_name "seedndestroy"
 
#/rat/proclast outroot
/rat/proclast eosntuple
/rat/proc prune
/rat/procset prune "mc.track:opticalphoton"
#/rat/procset prune "mc.track,mc.particle"
#END EVENT LOOP
##### GENERATORS #################
/generator/add combo cry:point
/generator/pos/set 0.0 0.0 2000.0
#/generator/add combo gun:fill:poisson
#/generator/vtx/set mu- 0.0 0.0 0.0 200.0
#/generator/pos/set 0.0 0.0 0.0
##### RUN ###########
/run/beamOn 100
